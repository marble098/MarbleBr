{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "every weekend"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies",
    "automated-update"
  ],
  "rangeStrategy": "bump",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Upgrade all stable and beta AndroidX, Compose BOM, Kotlin, Gradle plugins, and GeckoView weekly",
      "matchDatasources": [
        "maven",
        "gradle-version"
      ],
      "ignoreUnstable": false,
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+((-beta|-rc|\\.)[0-9]+)?$/",
      "automerge": true
    },
    {
      "description": "Group Kotlin and KSP updates together",
      "groupName": "Kotlin and KSP",
      "matchPackagePrefixes": [
        "org.jetbrains.kotlin",
        "com.google.devtools.ksp"
      ],
      "automerge": true
    },
    {
      "description": "Group Jetpack Compose BOM and Material 3 Expressive updates",
      "groupName": "Jetpack Compose",
      "matchPackagePrefixes": [
        "androidx.compose"
      ],
      "automerge": true
    },
    {
      "description": "Track Mozilla GeckoView latest stable/beta builds",
      "groupName": "Mozilla GeckoView",
      "matchPackagePrefixes": [
        "org.mozilla.geckoview"
      ],
      "ignoreUnstable": false,
      "automerge": true
    }
  ]
}
