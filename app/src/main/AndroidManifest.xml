<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- GeckoView delegates WebAuthn origins and candidate lookup to Android Credential Manager on API 34+. -->
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!--
      «رمزِ یکبارمصرف»: خواندنِ پیامکِ تازه فقط برای همان لحظه‌ای که کاربر روی صفحهٔ کد است.
      این مجوز اختیاری است؛ اگر کاربر ندهد، مسیرِ «اعلان‌ها» و «جای‌گذاریِ دستی» کار می‌کند.
      هیچ پیامکی ذخیره یا به هیچ سروری ارسال نمی‌شود (AGENTS.md: عدم خروج داده).
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- RECEIVE_SMS فقط پیامکِ تازه را می‌گیرد؛ برای خواندنِ صندوقِ ورودی (پیامکی که
         قبل از باز شدنِ صفحهٔ کد رسیده) READ_SMS هم لازم است. پیش‌تر فقط RECEIVE_SMS بود
         و `recentMessages()` همیشه خالی برمی‌گشت. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- دسترسی‌های سایت: دوربین، میکروفون و موقعیت. فقط وقتی کاربر در پنجرهٔ دسترسی
         «اجازه» بدهد از سیستم خواسته می‌شوند؛ هرگز در راه‌اندازی اولیه پرسیده نمی‌شوند. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MarbleBrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarbleBr"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          سرویسِ «دسترسی به اعلان‌ها» نسخهٔ اندروید برای استخراجِ کد از اعلان (واتساپ، تلگرام،
          اپ‌های بانکی). کاربر آن را در تنظیماتِ سیستم روشن می‌کند و اپ متنِ اعلان را ذخیره نمی‌کند.
        -->
        <service
            android:name="com.marble098.marblebr.vault.MarbleNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Disable default WorkManager initializer so HiltWorkerFactory is used -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
